# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database / Vector Search
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ota_faq_assistant
VECTOR_STORE_URL=

# LLM & Embeddings Providers
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Auth & Security
ADMIN_API_KEY=
CORS_ORIGIN=http://localhost:5173

